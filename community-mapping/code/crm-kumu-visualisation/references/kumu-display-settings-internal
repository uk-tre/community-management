@controls {
  top-left {
    search {}

    filter {
      target: element;
      by: "type-display";
      as: dropdown;
      multiple: true;
      default: show-all;
      label: "filter by type";
    }

    filter {
      target: element;
      by: "mapping-consent";
      as: dropdown;
      multiple: true;
      default: show-all;
      label: "filter by consent for mapping";
    }

    filter {
      target: element;
      by: "link-status";
      as: dropdown;
      multiple: true;
      default: show-all;
      label: "filter by email-link status";
    }

    filter {
      target: element;
      by: "on-slack";
      as: dropdown;
      multiple: true;
      default: show-all;
      label: "on Slack";
    }

    filter {
      target: element;
      by: "on-jisc";
      as: dropdown;
      multiple: true;
      default: show-all;
      label: "on Jisc";
    }
  }
}

@settings {
  template: stakeholder;
  element-shape: categorize("type-display");
  element-scale: scale("Size", 0.5, 3);
  element-color: categorize("type-display", #000000 "Person", #004488 "working-group", #6699CC "interest-group", #CC6677 "Funder", #332288 "Consortium", #DDCC77 "Academic institute", #117733 "Public sector / Government", #88CCEE "Intergovernmental organisation", #882255 "Non-profit", #44AA99 "Social enterprise", #999933 "Cooperative", #AA4499 "Private industry");
}
